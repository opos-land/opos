# The admin application's build-time address: the dev server and the unit tests fall back to it.
# The API; no variable of the admin application names Supabase.
VITE_API_URL=http://api.opos.localhost:3001

# The interface and port the dev server binds. The browser still opens the address the API names;
# 0.0.0.0 serves the dev server to the network as well.
OPOS_ADMIN_HOST=127.0.0.1
OPOS_ADMIN_PORT=5175
