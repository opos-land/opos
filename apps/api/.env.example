# The API's variables. `pnpm infra:init` writes apps/api/.env from this file and fills the empty
# values. No password, key or secret ever enters this template.

# development on a machine and in the tests; a deployment sets production
NODE_ENV=development
# The port of API_URL, where Supabase Auth calls the send-email hook
PORT=3001
# local on a machine and in CI, dev or production on a deployment; infra:init fills it
OPOS_ENV=local

# opos_app on the local stack; infra:init builds it from OPOS_APP_PASSWORD in packages/db/.env
DATABASE_URL=
# opos_app_global on the local stack; infra:init builds it from OPOS_APP_GLOBAL_PASSWORD
DATABASE_GLOBAL_URL=
# postgres on the local stack, from `supabase status`; read by the API and e2e tests and by
# `pnpm db:account:reset-2fa`, never by the running API
DATABASE_MIGRATION_URL=

# The Supabase gateway, with Auth at /auth/v1, from `supabase status`
SUPABASE_URL=
# The project's secret key, from `supabase status`; sent as apikey with every Supabase Auth call
SUPABASE_SECRET_KEY=

# The send-email hook's secret, the same value as in supabase/.env; infra:init fills it
SEND_EMAIL_HOOK_SECRET=
# Signs organizer invitations, at least 32 characters, equal to no other secret; infra:init fills it
INVITE_SECRET=

# The API's own address
API_URL=http://api.opos.localhost:3001
# The panel's address, allowed by CORS
PANEL_URL=http://panel.opos.localhost:5173
# The portal's address, allowed by CORS
PORTAL_URL=http://opos.localhost:5174

# The local Mailpit's SMTP host
SMTP_HOST=127.0.0.1
# The local Mailpit's SMTP port
SMTP_PORT=54325
# Empty locally: Mailpit takes mail without credentials
SMTP_USER=
# Empty locally: Mailpit takes mail without credentials
SMTP_PASS=
# The sender of every message the API sends
MAIL_FROM="OPOS <no-reply@opos.localhost>"

# Unset. When set, a positive integer that replaces the count of the default rate limit; only
# the e2e suite sets it, and the API refuses to start with it unless OPOS_ENV is local
# RATE_LIMIT_DEFAULT=
