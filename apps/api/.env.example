# The API's variables. `pnpm infra:init` writes apps/api/.env from this file and fills the empty
# values. No password, key or secret ever enters this template.

# development on a machine and in the tests; a deployment sets production
NODE_ENV=development
# The port of API_URL, where Supabase Auth calls the send-email hook
PORT=3001
# local on a machine and in CI, dev or production on a deployment; infra:init fills it
OPOS_ENV=local

# opos_app on the local stack; infra:init builds it from OPOS_APP_PASSWORD in packages/db/.env
DATABASE_URL=
# opos_app_global on the local stack; infra:init builds it from OPOS_APP_GLOBAL_PASSWORD
DATABASE_GLOBAL_URL=
# opos_admin on the local stack, for the admin routes alone; infra:init builds it from
# OPOS_ADMIN_PASSWORD. Unset, with ADMIN_URL, where the API serves no admin application
DATABASE_ADMIN_URL=
# postgres on the local stack, from `supabase status`; read by the API and e2e tests, never by the
# running API
DATABASE_MIGRATION_URL=

# The Supabase gateway, with Auth at /auth/v1, from `supabase status`
SUPABASE_URL=
# The project's secret key, from `supabase status`; sent as apikey with every Supabase Auth call
SUPABASE_SECRET_KEY=

# The send-email hook's secret, the same value as in supabase/.env; infra:init fills it
SEND_EMAIL_HOOK_SECRET=
# Signs organizer invitations, at least 32 characters, equal to no other secret; infra:init fills it
INVITE_SECRET=
# Seals a convention's payment provider credentials, at least 32 characters, equal to no other
# secret; infra:init fills it, with the same value in packages/db/.env for the seed
PAYMENT_CREDENTIALS_KEY=

# The API's own address
API_URL=http://api.opos.localhost:3001
# The panel's address, allowed by CORS
PANEL_URL=http://panel.opos.localhost:5173
# The portal's address, allowed by CORS
PORTAL_URL=http://opos.localhost:5174
# The admin application's address, allowed by CORS; set together with DATABASE_ADMIN_URL
ADMIN_URL=http://admin.opos.localhost:5175

# The local Mailpit's SMTP host
SMTP_HOST=127.0.0.1
# The local Mailpit's SMTP port
SMTP_PORT=54325
# Empty locally: Mailpit takes mail without credentials
SMTP_USER=
# Empty locally: Mailpit takes mail without credentials
SMTP_PASS=
# The sender of every message the API sends
MAIL_FROM="OPOS <no-reply@opos.localhost>"

# The bucket of uploaded files: the local Versity Gateway of infra/local/compose.yaml, on the port
# OPOS_S3_PORT moves; infra:init fills it
S3_ENDPOINT=
# The bucket's region, which the local gateway takes as its own
S3_REGION=local
# The bucket's name, which the local gateway makes on start
S3_BUCKET=opos
# The bucket's key, the local gateway's root key; infra:init fills both
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The image server, imgproxy of infra/local/compose.yaml, on the port OPOS_IMGPROXY_PORT moves;
# infra:init fills it
IMGPROXY_URL=
# The key and the salt imgproxy checks every request's signature with, hex; infra:init fills both
IMGPROXY_KEY=
IMGPROXY_SALT=
# The bucket's address as imgproxy reaches it, on the local stack's own network; the API signs the
# addresses imgproxy reads for it. Unset where it is S3_ENDPOINT
IMGPROXY_BUCKET_ENDPOINT=http://s3:7070

# The address the API calls a payment provider from, which never changes: a convention enters
# it in its provider's panel, and the provider account's screen shows it. Unset on local.
# API_EGRESS_ADDRESS=

# Where Przelewy24 answers, in place of its own two addresses. Only the tests of its module set
# them, and only on local.
# PRZELEWY24_URL=
# PRZELEWY24_SANDBOX_URL=

# Unset. When set, a positive integer that replaces the count of the default rate limit; only
# the e2e suite sets it, and the API refuses to start with it unless OPOS_ENV is local
# RATE_LIMIT_DEFAULT=
