# The panel's build-time addresses (docs/PLAN.md, 11). The dev server and the unit tests fall back to
# this file; a production build reads only the environment and .env.

# The API
VITE_API_URL=http://api.opos.localhost:3001
# Supabase Auth on the local stack's gateway, until sign-in moves to the API (docs/PLAN.md, 3.2)
VITE_AUTH_URL=http://127.0.0.1:54321/auth/v1
