msgid "{name} (suspended)"
msgstr "{name} (konwent zawieszony)"

#: src/features/team/components/remove-member.tsx
msgid "{name} loses access to the convention at once. Coming back takes a new invitation."
msgstr "{name} od razu straci dostęp do konwentu. Powrót do zespołu wymaga nowego zaproszenia."

#: src/features/catalog/components/variants-editor.tsx
msgid "{name}: exists"
msgstr "{name}: istnieje"

