#: src/features/landing/pages/privacy-page.tsx
msgid "Database backups contain personal data. They are encrypted and kept under the same rules as the data itself."
msgstr "Kopie zapasowe bazy danych zawierają dane osobowe. Są szyfrowane i przechowywane na tych samych zasadach co same dane."

#: src/features/account/components/delete-account.tsx
