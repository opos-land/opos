#: src/features/auth/pages/forgot-password-page.tsx
msgid "If an account uses {sentTo}, we sent it a link to set a new password. The link works once, for one hour."
msgstr "Jeśli adres {sentTo} należy do konta, wysłaliśmy na niego link do ustawienia nowego hasła. Link działa jeden raz, przez godzinę."

#: src/features/auth/pages/auth-callback-page.tsx
msgid "If you opened a confirmation link, your address may be confirmed already."
msgstr "Jeśli otwierasz link potwierdzający, twój adres może być już potwierdzony."

#: src/features/landing/pages/privacy-page.tsx
msgid "If you sign in with Google, Google confirms your email address and gives us your name."
msgstr "Jeśli logujesz się przez Google, Google potwierdza twój adres e-mail i przekazuje nam twoje imię i nazwisko."

