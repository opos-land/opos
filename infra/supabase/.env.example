# Dev configuration of the auth service, read by docker-compose.yml.
# JWT and hook secrets must equal JWT_SECRET and SEND_EMAIL_HOOK_SECRET in apps/api/.env.

GOTRUE_JWT_SECRET=dev-jwt-secret-at-least-32-characters-long
GOTRUE_HOOK_SEND_EMAIL_SECRETS=v1,whsec_ZGV2LXNlbmQtZW1haWwtaG9vay1zZWNyZXQ=

# Google OAuth client; leave empty unless working on Google sign-in.
# Authorized redirect URI: http://localhost:9999/callback
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
