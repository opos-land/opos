{
  "name": "opos",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "local:start": "turbo run local:start --ui=tui",
    "local:links": "node scripts/local-links.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:scripts": "node --test --experimental-test-coverage --test-coverage-include='scripts/*.mjs' --test-coverage-exclude='scripts/*.test.mjs' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'scripts/*.test.mjs' '.claude/*.test.mjs' '.claude/hooks/**/*.test.mjs' '.claude/skills/**/*.test.mjs'",
    "i18n:extract": "turbo run i18n:extract",
    "i18n:compile": "turbo run i18n:compile",
    "i18n:check": "turbo run i18n:check",
    "db:generate": "turbo run db:generate --",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed --",
    "db:roles": "turbo run db:roles",
    "db:studio": "turbo run db:studio",
    "db:verify": "turbo run db:verify",
    "db:admin:grant": "turbo run db:admin:grant --",
    "db:admin:revoke": "turbo run db:admin:revoke --",
    "db:totp": "turbo run db:totp --",
    "format": "prettier --write . && node scripts/markdown-tables.mjs --write",
    "format:check": "prettier --check . && node scripts/markdown-tables.mjs",
    "deps:licenses": "node scripts/deps-licenses.mjs",
    "deploy:login": "node scripts/deploy.mjs login",
    "deploy:bootstrap": "node scripts/deploy.mjs bootstrap",
    "deploy:access:grant": "node scripts/deploy.mjs access:grant",
    "deploy:access:revoke": "node scripts/deploy.mjs access:revoke",
    "deploy:plan": "node scripts/deploy.mjs plan",
    "deploy:apply": "node scripts/deploy.mjs apply",
    "deploy:destroy": "node scripts/deploy.mjs destroy",
    "deploy:import": "node scripts/deploy.mjs import",
    "deploy:output": "node scripts/deploy.mjs output",
    "deploy:secret:set": "node scripts/deploy.mjs secret:set",
    "deploy:secret:get": "node scripts/deploy.mjs secret:get",
    "infra:check": "export TG_DOWNLOAD_DIR=\"$PWD/infra/.terragrunt-cache/check\" && tofu fmt -check -recursive infra && terragrunt hcl fmt --check --working-dir infra && terragrunt run --all --working-dir infra/live --no-auto-init --non-interactive --no-dependency-outputs -- init -backend=false -input=false -lockfile=readonly && terragrunt run --all --working-dir infra/live --no-auto-init --non-interactive --no-dependency-outputs -- validate",
    "infra:images": "infra/docker/check.sh",
    "infra:lock": "for module in infra/modules/*/; do tofu -chdir=\"$module\" providers lock -platform=linux_amd64 -platform=linux_arm64 -platform=darwin_arm64 || exit 1; done",
    "infra:graph": "node scripts/infra-graph.mjs",
    "stack:init": "node scripts/stack-init.mjs",
    "stack:up": "supabase start && docker compose -p opos-local --env-file apps/api/.env -f infra/local/compose.yaml up -d --wait",
    "stack:down": "docker compose -p opos-local --env-file apps/api/.env -f infra/local/compose.yaml down && supabase stop",
    "stack:reset": "supabase stop --no-backup && docker compose -p opos-local --env-file apps/api/.env -f infra/local/compose.yaml down --volumes && supabase start && docker compose -p opos-local --env-file apps/api/.env -f infra/local/compose.yaml up -d --wait && pnpm db:roles"
  },
  "devDependencies": {
    "@cdktf/hcl2json": "0.21.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "catalog:",
    "lefthook": "^1.10.10",
    "prettier": "^3.4.2",
    "turbo": "^2.11.8",
    "yaml": "^2.9.1"
  }
}
