# The variables of the db:* scripts and the schema tests (docs/PLAN.md, 11). `pnpm infra:init` writes
# packages/db/.env from this file and fills the empty values. No password, key or secret ever enters
# this template.

# local on a machine and in CI, dev or production on a deployment; infra:init fills it
OPOS_ENV=
# postgres on the local stack, from `supabase status`; every db:* script connects through it
DATABASE_MIGRATION_URL=
# The password db:roles gives opos_app, in hex; infra:init fills it
OPOS_APP_PASSWORD=
# The password db:roles gives opos_app_global, in hex; infra:init fills it
OPOS_APP_GLOBAL_PASSWORD=
# The Supabase gateway, with Auth at /auth/v1, from `supabase status`; db:seed creates accounts there
SUPABASE_URL=
# The project's secret key, from `supabase status`; db:seed sends it as apikey
SUPABASE_SECRET_KEY=
