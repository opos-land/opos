# The variables of the db:* scripts and the schema tests. `pnpm stack:init` writes packages/db/.env
# from this file and fills the empty values. No password, key or secret ever enters this template.

# local on a machine and in CI, dev or production on a deployment; stack:init fills it
OPOS_ENV=
# postgres on the local stack, from `supabase status`; every db:* script connects through it
DATABASE_MIGRATION_URL=
# The password db:roles gives opos_app, in hex; stack:init fills it
OPOS_APP_PASSWORD=
# The password db:roles gives opos_app_global, in hex; stack:init fills it
OPOS_APP_GLOBAL_PASSWORD=
# The password db:roles gives opos_admin, in hex; stack:init fills it
OPOS_ADMIN_PASSWORD=
# Seals the demo convention's payment provider credentials in db:seed: the API's own
# PAYMENT_CREDENTIALS_KEY; stack:init fills both
PAYMENT_CREDENTIALS_KEY=
# The Supabase gateway, with Auth at /auth/v1, from `supabase status`; db:seed creates accounts there
SUPABASE_URL=
# The project's secret key, from `supabase status`; db:seed sends it as apikey
SUPABASE_SECRET_KEY=
# The bucket db:seed puts the demo edition's legal documents into: the API's own, of
# infra/local/compose.yaml on the port OPOS_S3_PORT moves; stack:init fills the empty ones
S3_ENDPOINT=
S3_REGION=local
S3_BUCKET=opos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
