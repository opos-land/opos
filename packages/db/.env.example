# Read by the db:* scripts and the schema tests of packages/db.
# `pnpm infra:init` writes packages/db/.env from this file and fills the empty values.

# The environment the scripts run against; they refuse a remote database unless it is dev or production
OPOS_ENV=local

# The migration role (postgres) of the local stack; filled by pnpm infra:init from supabase status
DATABASE_MIGRATION_URL=

# Passwords of the runtime roles opos_app and opos_app_global, set by db:roles; filled by pnpm infra:init
OPOS_APP_PASSWORD=
OPOS_APP_GLOBAL_PASSWORD=

# The stack's gateway and secret key, for db:seed; filled by pnpm infra:init from supabase status
SUPABASE_URL=
SUPABASE_SECRET_KEY=
