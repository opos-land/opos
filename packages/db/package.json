{
  "name": "@opos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./totp": "./src/totp.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:roles": "tsx --env-file-if-exists=.env src/scripts/roles.ts",
    "db:verify": "tsx --env-file-if-exists=.env src/scripts/verify.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:tenant:create": "tsx --env-file-if-exists=.env src/scripts/create-tenant.ts",
    "db:tenant:rename": "tsx --env-file-if-exists=.env src/scripts/rename-tenant.ts",
    "db:admin:grant": "tsx --env-file-if-exists=.env src/scripts/grant-admin.ts",
    "db:admin:revoke": "tsx --env-file-if-exists=.env src/scripts/revoke-admin.ts"
  },
  "dependencies": {
    "@opos/i18n": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@opos/eslint-config": "workspace:*",
    "@opos/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
