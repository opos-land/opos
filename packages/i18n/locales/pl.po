msgid "booth"
msgstr "stoisko"

#: src/errors.ts
msgid "Check the data you entered."
msgstr "Sprawdź wprowadzone dane."

#: src/errors.ts
msgid "Choose a time zone from the list."
msgstr "Wybierz strefę czasową z listy."

#: src/errors.ts
msgid "Confirm your email address first. Check your inbox for the link."
msgstr "Najpierw potwierdź adres e-mail. Link znajdziesz w swojej skrzynce."

