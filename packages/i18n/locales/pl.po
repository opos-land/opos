msgid "organizer"
msgstr "organizator"

#. Glossary term: programme item
#: src/glossary.ts
msgctxt "glossary"
msgid "programme item"
msgstr "punkt programu"

#. Glossary term: review
#: src/glossary.ts
msgctxt "glossary"
msgid "review"
msgstr "opinia"

#. Glossary term: scanner
#: src/glossary.ts
msgctxt "glossary"
msgid "scanner"
msgstr "skaner"

#: src/errors.ts
msgid "Sign-up is closed at the moment."
msgstr "Rejestracja jest teraz zamknięta."

#: src/errors.ts
msgid "Something went wrong. Try again."
msgstr "Coś poszło nie tak. Spróbuj ponownie."

#. Glossary term: speaker
#: src/glossary.ts
msgctxt "glossary"
msgid "speaker"
msgstr "prelegent"

#: src/errors.ts
msgid "The address may contain only lowercase letters, digits and hyphens, 3 to 40 characters."
msgstr "Adres może zawierać tylko małe litery, cyfry i myślniki, od 3 do 40 znaków."

#: src/errors.ts
msgid "The link has expired. Ask for a new one."
msgstr "Link wygasł. Poproś o nowy."

#: src/errors.ts
msgid "The new password must differ from the current one."
msgstr "Nowe hasło musi różnić się od obecnego."

#: src/errors.ts
msgid "The password is too weak. Use at least 8 characters."
msgstr "Hasło jest za słabe. Użyj co najmniej 8 znaków."

#: src/errors.ts
msgid "This address is already taken by another convention."
msgstr "Ten adres jest już zajęty przez inny konwent."

#: src/errors.ts
msgid "This convention already has an edition with this address."
msgstr "Ten konwent ma już edycję o tym adresie."

#: src/errors.ts
msgid "This language is not supported."
msgstr "Ten język nie jest obsługiwany."

#. Glossary term: ticket
#: src/glossary.ts
msgctxt "glossary"
msgid "ticket"
msgstr "akredytacja"

#. Glossary term: ticket type
#: src/glossary.ts
msgctxt "glossary"
msgid "ticket type"
msgstr "rodzaj akredytacji"

#: src/errors.ts
msgid "Too many attempts. Try again in a few minutes."
msgstr "Zbyt wiele prób. Spróbuj ponownie za kilka minut."

#: src/errors.ts
msgid "Too many attempts. Try again in a moment."
msgstr "Zbyt wiele prób. Spróbuj ponownie za chwilę."

#: src/errors.ts
msgid "Too many emails sent. Try again in a few minutes."
msgstr "Wysłano zbyt wiele wiadomości. Spróbuj ponownie za kilka minut."

#. Glossary term: user
#: src/glossary.ts
msgctxt "glossary"
msgid "user"
msgstr "użytkownik"

#: src/errors.ts
msgid "We could not find this convention."
msgstr "Nie znaleziono tego konwentu."

#: src/errors.ts
msgid "We could not find what you are looking for."
msgstr "Nie znaleziono tego, czego szukasz."

#: src/errors.ts
msgid "Wrong email or password."
msgstr "Nieprawidłowy e-mail lub hasło."

#: src/errors.ts
msgid "You cannot change the permissions of someone whose access lasts longer than yours."
msgstr "Nie możesz zmieniać uprawnień osoby, której dostęp trwa dłużej niż twój."

#: src/errors.ts
msgid "You cannot change your own role or permissions, or remove yourself from the team."
msgstr "Nie możesz zmienić własnej roli ani uprawnień, ani usunąć siebie z zespołu."

#: src/errors.ts
msgid "You cannot delete the active edition. Activate another edition first."
msgstr "Nie możesz usunąć aktywnej edycji. Najpierw aktywuj inną edycję."

#: src/errors.ts
msgid "You cannot grant permissions higher than your own."
msgstr "Nie możesz nadać uprawnień wyższych niż własne."

#: src/errors.ts
msgid "You cannot set an access end date later than your own, or remove it."
msgstr "Nie możesz ustawić daty końca dostępu późniejszej niż własna ani jej usunąć."

#: src/errors.ts
msgid "You do not have permission to do this."
msgstr "Nie masz uprawnień, żeby to zrobić."

#: src/errors.ts
msgid "Your session has ended. Sign in again."
msgstr "Twoja sesja wygasła. Zaloguj się ponownie."
