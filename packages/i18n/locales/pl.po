#: src/errors.ts
msgid "A convention must keep at least one head organizer. Make someone else a head organizer first."
msgstr "Konwent musi mieć co najmniej jednego głównego organizatora. Najpierw nadaj tę rolę komuś innemu."

#: src/errors.ts
msgid "A head organizer already has access to every edition."
msgstr "Główny organizator ma już dostęp do każdej edycji."

#. Glossary term: admin
#: src/glossary.ts
msgctxt "glossary"
msgid "administrator"
msgstr "administrator"

#: src/errors.ts
msgid "An account with this email address already exists."
msgstr "Konto z tym adresem e-mail już istnieje."

