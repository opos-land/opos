#: src/errors.ts
msgid "Nothing can be added to this order: you buy more only for your own paid order."
msgstr "Do tego zamówienia nie można nic dokupić: dokupuje się tylko do własnego, opłaconego zamówienia."

#: src/order-emails.ts
msgid "Nothing else of the order changed, and your QR code stays the same."
msgstr "Nic poza tym w zamówieniu się nie zmieniło, a twój kod QR pozostaje ten sam."

#: src/profiles.ts
msgid "Offensive or unlawful content"
msgstr "Treść obraźliwa lub bezprawna"

#: src/errors.ts
msgid "Only a head organizer can edit or remove another head organizer."
msgstr "Tylko główny organizator może edytować lub usunąć innego głównego organizatora."

#: src/errors.ts
msgid "Only a paid order can be canceled."
msgstr "Anulować można tylko opłacone zamówienie."

#: src/errors.ts
msgid "Only a suspended convention can be deleted. Suspend it first."
msgstr "Usunąć można tylko zawieszony konwent. Najpierw go zawieś."

#: src/errors.ts
msgid "Open the link in the browser where you asked for it, or ask for a new link there."
msgstr "Otwórz link w przeglądarce, w której o niego poproszono, albo poproś tam o nowy link."

