msgstr "rdzeń"

#. Glossary term: edition
#: src/glossary.ts
msgctxt "glossary"
msgid "edition"
msgstr "edycja"

#: src/errors.ts
msgid "Enter a valid email address."
msgstr "Podaj prawidłowy adres e-mail."

#: src/errors.ts
msgid "Enter the convention name."
msgstr "Podaj nazwę konwentu."

#. Glossary term: head
#: src/glossary.ts
msgctxt "glossary"
msgid "head organizer"
msgstr "główny organizator"

#. Glossary term: locale
#: src/glossary.ts
