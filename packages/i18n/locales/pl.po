msgstr "Płatność za zamówienie {number} została odrzucona"

#: src/errors.ts
msgid "The payment provider cannot take this email address. Use a shorter one."
msgstr "Dostawca płatności nie przyjmuje tego adresu e-mail. Użyj krótszego adresu."

