#: src/errors.ts
msgid "We could not confirm that you are not a robot. Try again."
msgstr "Nie udało się potwierdzić, że nie jesteś robotem. Spróbuj ponownie."

#: src/errors.ts
msgid "We could not find this convention."
msgstr "Nie znaleziono tego konwentu."

#: src/errors.ts
msgid "We could not find what you are looking for."
msgstr "Nie znaleziono tego, czego szukasz."

#: src/emails.ts
msgid "We received a request to change the email address of your OPOS account from {oldEmail} to {newEmail}. Confirm it with the link below."
msgstr "Otrzymaliśmy prośbę o zmianę adresu e-mail twojego konta w OPOS z {oldEmail} na {newEmail}. Potwierdź ją, korzystając z poniższego linku."

#: src/emails.ts
msgid "We received a request to reset the password of your OPOS account. Set a new password with the link below."
msgstr "Otrzymaliśmy prośbę o zresetowanie hasła do twojego konta w OPOS. Ustaw nowe hasło, korzystając z poniższego linku."

#: src/emails.ts
msgid "We received your report of a profile"
msgstr "Otrzymaliśmy twoje zgłoszenie profilu"

#: src/emails.ts
msgid "We will write to this address once more, to say what was decided. If you sent no report, ignore this message."
msgstr "Napiszemy na ten adres jeszcze raz, żeby przekazać decyzję. Jeśli to nie twoje zgłoszenie, zignoruj tę wiadomość."

#: src/order-emails.ts
msgid "With questions, write to {contactEmail}."
msgstr "W razie pytań napisz na adres {contactEmail}."

#: src/exports.ts
msgctxt "export value"
msgid "With the buyer"
msgstr "U kupującego"

#: src/exports.ts
msgctxt "export value"
msgid "With the convention"
msgstr "U konwentu"

#: src/errors.ts
msgid "Wrong email or password."
msgstr "Nieprawidłowy e-mail lub hasło."

#: src/errors.ts
msgid "You are already in this convention's team."
msgstr "Już należysz do zespołu tego konwentu."

#: src/emails.ts
msgid "You are now a member of the organizing team of {tenantName} in OPOS. Open the panel to see what you can work on."
msgstr "Należysz teraz do zespołu organizatorów konwentu {tenantName} w OPOS. Otwórz panel, aby zobaczyć, nad czym możesz pracować."

#: src/order-emails.ts
msgid "You can also write to {contactEmail}."
msgstr "Możesz też napisać na adres {contactEmail}."

#. placeholder {0}: takedown.contact
#: src/emails.ts
msgid "You can change your profile and then ask for a review on the profile page of your account. If you do not agree with the decision, write to {0}."
msgstr "Możesz zmienić profil, a potem poprosić o sprawdzenie na stronie profilu swojego konta. Jeśli nie zgadzasz się z decyzją, napisz na adres {0}."

#. placeholder {0}: cleared.contact
#: src/emails.ts
msgid "You can enter your name again in your account settings. If you do not agree with the decision, write to {0}."
msgstr "Nazwę możesz wpisać ponownie w ustawieniach konta. Jeśli nie zgadzasz się z decyzją, napisz na adres {0}."

#: src/errors.ts
msgid "You cannot change your own role or permissions, or remove yourself from the team."
msgstr "Nie możesz zmienić własnej roli ani uprawnień, ani usunąć siebie z zespołu."

#: src/errors.ts
msgid "You cannot delete the active edition. Activate another edition first."
msgstr "Nie możesz usunąć aktywnej edycji. Najpierw aktywuj inną edycję."

#: src/errors.ts
msgid "You cannot give anyone access that lasts longer than yours."
msgstr "Nie możesz nikomu nadać dostępu, który trwałby dłużej niż twój."

#: src/errors.ts
msgid "You cannot grant permissions higher than your own."
msgstr "Nie możesz nadać uprawnień wyższych niż własne."

#: src/errors.ts
msgid "You cannot raise the permissions of someone whose access lasts longer than yours."
msgstr "Nie możesz zwiększyć uprawnień osoby, której dostęp trwa dłużej niż twój."

#: src/errors.ts
msgid "You do not have permission to do this."
msgstr "Nie masz uprawnień, żeby to zrobić."

#: src/emails.ts
msgid "You have been invited to the organizing team of {tenantName} in OPOS. Accept the invitation with the link below. If you do not have an OPOS account yet, you can create one on the same page."
msgstr "Zaproszono cię do zespołu organizatorów konwentu {tenantName} w OPOS. Przyjmij zaproszenie, korzystając z poniższego linku. Jeśli nie masz jeszcze konta w OPOS, możesz je założyć na tej samej stronie."

#: src/emails.ts
msgid "You have joined the organizing team of {tenantName}"
msgstr "Dołączono cię do zespołu organizatorów konwentu {tenantName}"

#: src/emails.ts
msgid "Your avatar was removed when the profile was taken down. You can upload one again."
msgstr "Twój awatar został usunięty, gdy profil został zdjęty. Możesz wgrać nowy."

#: src/order-emails.ts
msgid "Your order"
msgstr "Twoje zamówienie"

#: src/order-emails.ts
msgid "Your order {number} for {conventionName} has expired"
msgstr "Twoje zamówienie {number} w sklepie konwentu {conventionName} wygasło"

#: src/order-emails.ts
msgid "Your order {number} for {conventionName} is now under this email address"
msgstr "Twoje zamówienie {number} w sklepie konwentu {conventionName} jest teraz przypisane do tego adresu e-mail"

#: src/order-emails.ts
msgid "Your order {number} for {conventionName} is paid"
msgstr "Twoje zamówienie {number} w sklepie konwentu {conventionName} jest opłacone"

#: src/order-emails.ts
msgid "Your order {number} for {conventionName} was canceled"
msgstr "Twoje zamówienie {number} w sklepie konwentu {conventionName} zostało anulowane"

#: src/order-emails.ts
msgid "Your order {number} for {conventionName} was moved to another email address"
msgstr "Twoje zamówienie {number} w sklepie konwentu {conventionName} przeniesiono na inny adres e-mail"

#: src/order-emails.ts
msgid "Your order {number} for {conventionName} was not paid in time and has expired. Nothing was charged."
msgstr "Twoje zamówienie {number} w sklepie konwentu {conventionName} nie zostało opłacone na czas i wygasło. Nie pobrano żadnych pieniędzy."

#: src/order-emails.ts
msgid "Your payment for the order {number} for {conventionName} arrived, but it could not confirm the order, so an organizer has to look at it."
msgstr "Twoja płatność za zamówienie {number} w sklepie konwentu {conventionName} dotarła, ale nie udało się nią potwierdzić zamówienia, więc musi je sprawdzić organizator."

#: src/order-emails.ts
msgid "Your payment for the order {number} is under review"
msgstr "Twoja płatność za zamówienie {number} jest wyjaśniana"

#: src/emails.ts
msgid "Your profile can be published again"
msgstr "Twój profil można znowu opublikować"

#: src/emails.ts
msgid "Your profile was taken down"
msgstr "Twój profil został zdjęty"

#: src/order-emails.ts
msgid "Your QR code"
msgstr "Twój kod QR"

#: src/emails.ts
msgid "Your report of a profile on OPOS has reached the administrators. They will look at the profile and decide whether it stays."
msgstr "Twoje zgłoszenie profilu w OPOS dotarło do administratorów. Obejrzą profil i zdecydują, czy zostaje."

#: src/errors.ts
msgid "Your session has ended. Sign in again."
msgstr "Twoja sesja wygasła. Zaloguj się ponownie."
