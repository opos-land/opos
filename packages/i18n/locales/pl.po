#: src/errors.ts
msgid "A convention must keep at least one head organizer. Make someone else a head organizer first."
msgstr "Konwent musi mieć co najmniej jednego głównego organizatora. Najpierw nadaj tę rolę komuś innemu."

#: src/errors.ts
msgid "A head organizer already has access to every edition."
msgstr "Główny organizator ma już dostęp do każdej edycji."

#: src/emails.ts
msgid "Accept the invitation"
msgstr "Przyjmij zaproszenie"

#. Glossary term: admin
#: src/glossary.ts
msgctxt "glossary"
msgid "administrator"
msgstr "administrator"

#: src/errors.ts
msgid "An account with this email address already exists."
msgstr "Konto z tym adresem e-mail już istnieje."

#. Glossary term: attendee
#: src/glossary.ts
msgctxt "glossary"
msgid "attendee"
msgstr "uczestnik"

#. Glossary term: booth
#: src/glossary.ts
msgctxt "glossary"
msgid "booth"
msgstr "stoisko"

#: src/errors.ts
msgid "Check the data you entered."
msgstr "Sprawdź wprowadzone dane."

#: src/errors.ts
msgid "Choose a time zone from the list."
msgstr "Wybierz strefę czasową z listy."

#: src/emails.ts
msgid "Confirm email address"
msgstr "Potwierdź adres e-mail"

#: src/errors.ts
msgid "Confirm it is you: enter your password again or sign in with Google again."
msgstr "Potwierdź, że to ty: wpisz ponownie hasło albo znów zaloguj się przez Google."

#: src/emails.ts
msgid "Confirm that {email} is the new email address of your OPOS account."
msgstr "Potwierdź, że {email} to nowy adres e-mail twojego konta w OPOS."

#: src/emails.ts
msgid "Confirm the change"
msgstr "Potwierdź zmianę"

#: src/emails.ts
msgid "Confirm the change of your email address"
msgstr "Potwierdź zmianę adresu e-mail"

#: src/emails.ts
msgid "Confirm the new address"
msgstr "Potwierdź nowy adres"

#: src/emails.ts
msgid "Confirm your email address"
msgstr "Potwierdź swój adres e-mail"

#: src/errors.ts
msgid "Confirm your email address first. Check your inbox for the link."
msgstr "Najpierw potwierdź adres e-mail. Link znajdziesz w swojej skrzynce."

#: src/emails.ts
msgid "Confirm your email address to finish creating your OPOS account."
msgstr "Potwierdź adres e-mail, aby dokończyć zakładanie konta w OPOS."

#: src/emails.ts
msgid "Confirm your new email address"
msgstr "Potwierdź nowy adres e-mail"

#. Glossary term: tenant
#: src/glossary.ts
msgctxt "glossary"
msgid "convention"
msgstr "konwent"

#. Glossary term: core
#: src/glossary.ts
msgctxt "glossary"
msgid "core"
msgstr "rdzeń"

#. Glossary term: edition
#: src/glossary.ts
msgctxt "glossary"
msgid "edition"
msgstr "edycja"

#: src/errors.ts
msgid "Enter a valid email address."
msgstr "Podaj prawidłowy adres e-mail."

#: src/errors.ts
msgid "Enter the convention name."
msgstr "Podaj nazwę konwentu."

#. Glossary term: head
#: src/glossary.ts
msgctxt "glossary"
msgid "head organizer"
msgstr "główny organizator"

#: src/emails.ts
msgid "If the button does not work, copy this address into your browser:"
msgstr "Jeśli przycisk nie działa, skopiuj ten adres do przeglądarki:"

#: src/emails.ts
msgid "If you did not ask for it, ignore this message. Your password stays the same."
msgstr "Jeśli to nie ty o to prosisz, zignoruj tę wiadomość. Twoje hasło się nie zmieni."

#: src/emails.ts
msgid "If you did not ask for this change, do not confirm it and change your password."
msgstr "Jeśli to nie ty prosisz o tę zmianę, nie potwierdzaj jej i zmień hasło."

#: src/emails.ts
msgid "If you did not ask for this change, ignore this message."
msgstr "Jeśli to nie ty prosisz o tę zmianę, zignoruj tę wiadomość."

#: src/emails.ts
msgid "If you did not create an account, ignore this message."
msgstr "Jeśli to nie ty zakładasz konto, zignoruj tę wiadomość."

#: src/emails.ts
msgid "If you do not expect this invitation, ignore this message."
msgstr "Jeśli nie spodziewasz się tego zaproszenia, zignoruj tę wiadomość."

#: src/emails.ts
msgid "If you do not expect this, contact the head organizer of the convention."
msgstr "Jeśli się tego nie spodziewasz, skontaktuj się z głównym organizatorem konwentu."

#: src/emails.ts
msgid "Invitation to the organizing team of {tenantName}"
msgstr "Zaproszenie do zespołu organizatorów konwentu {tenantName}"

