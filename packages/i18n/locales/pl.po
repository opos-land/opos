msgstr "moduł"

#: src/errors.ts
msgid "No account uses this email address."
msgstr "Żadne konto nie używa tego adresu e-mail."

#: src/errors.ts
msgid "Only a head organizer can edit or remove another head organizer."
msgstr "Tylko główny organizator może edytować lub usunąć innego głównego organizatora."

#: src/emails.ts
msgid "Open the panel"
msgstr "Otwórz panel"

#. Glossary term: order
#: src/glossary.ts
msgctxt "glossary"
msgid "order"
msgstr "zamówienie"

#. Glossary term: org
#: src/glossary.ts
msgctxt "glossary"
msgid "organizer"
msgstr "organizator"

#. Glossary term: programme item
#: src/glossary.ts
msgctxt "glossary"
msgid "programme item"
msgstr "punkt programu"

#: src/emails.ts
msgid "Reset your password"
msgstr "Zresetuj hasło"

#. Glossary term: review
#: src/glossary.ts
msgctxt "glossary"
msgid "review"
msgstr "opinia"

#. Glossary term: scanner
#: src/glossary.ts
msgctxt "glossary"
msgid "scanner"
msgstr "skaner"

#: src/emails.ts
msgid "Set a new password"
msgstr "Ustaw nowe hasło"

#: src/errors.ts
msgid "Sign-up is closed at the moment."
msgstr "Rejestracja jest teraz zamknięta."

#: src/errors.ts
msgid "Something went wrong. Try again."
msgstr "Coś poszło nie tak. Spróbuj ponownie."

#. Glossary term: speaker
#: src/glossary.ts
msgctxt "glossary"
msgid "speaker"
msgstr "prelegent"

#: src/errors.ts
msgid "The account with this email address has not been confirmed yet."
msgstr "Konto z tym adresem e-mail nie zostało jeszcze potwierdzone."

#: src/errors.ts
msgid "The address may contain only lowercase letters, digits and hyphens, 3 to 40 characters."
msgstr "Adres może zawierać tylko małe litery, cyfry i myślniki, od 3 do 40 znaków."

#: src/errors.ts
msgid "The link has expired. Ask for a new one."
msgstr "Link wygasł. Poproś o nowy."

#: src/emails.ts
msgid "The link is valid for 1 hour and works once."
msgstr "Link jest ważny przez godzinę i działa tylko raz."

#: src/emails.ts
msgid "The link is valid for 7 days and works once."
msgstr "Link jest ważny przez 7 dni i działa tylko raz."

#: src/errors.ts
msgid "The new password must differ from the current one."
msgstr "Nowe hasło musi różnić się od obecnego."

#: src/errors.ts
msgid "The password is too weak. Use at least 8 characters."
msgstr "Hasło jest za słabe. Użyj co najmniej 8 znaków."

#: src/errors.ts
msgid "This address is already taken by another convention."
msgstr "Ten adres jest już zajęty przez inny konwent."

#: src/errors.ts
msgid "This address is reserved for the platform. Choose another one."
msgstr "Ten adres jest zarezerwowany dla platformy. Wybierz inny."

#: src/errors.ts
msgid "This convention already has an edition with this address."
msgstr "Ten konwent ma już edycję o tym adresie."

#: src/errors.ts
msgid "This invitation has already been accepted."
msgstr "To zaproszenie zostało już przyjęte."

#: src/errors.ts
msgid "This invitation has expired. Ask the convention's organizers for a new one."
msgstr "To zaproszenie wygasło. Poproś organizatorów konwentu o nowe."

#: src/errors.ts
msgid "This invitation is no longer valid: whoever sent it can no longer grant this access. Ask the convention's organizers for a new one."
msgstr "To zaproszenie straciło ważność: osoba, która je wysłała, nie może już przyznać tego dostępu. Poproś organizatorów konwentu o nowe."

#: src/errors.ts
msgid "This invitation link is not valid. Check that you opened the whole link from the email."
msgstr "Ten link z zaproszeniem jest nieprawidłowy. Sprawdź, czy otwierasz cały link z wiadomości."

#: src/errors.ts
msgid "This invitation was sent to another email address. Sign in with the account that uses that address."
msgstr "To zaproszenie wysłano na inny adres e-mail. Zaloguj się na konto, które używa tego adresu."

#: src/errors.ts
msgid "This language is not supported."
msgstr "Ten język nie jest obsługiwany."

#: src/errors.ts
msgid "This person is already in the team. Change their membership on the team screen."
msgstr "Ta osoba już należy do zespołu. Zmień jej członkostwo na ekranie zespołu."

#. Glossary term: ticket
#: src/glossary.ts
msgctxt "glossary"
msgid "ticket"
msgstr "akredytacja"

#. Glossary term: ticket type
#: src/glossary.ts
msgctxt "glossary"
msgid "ticket type"
msgstr "rodzaj akredytacji"

#: src/errors.ts
msgid "Too many attempts. Try again in a few minutes."
msgstr "Zbyt wiele prób. Spróbuj ponownie za kilka minut."

#: src/errors.ts
msgid "Too many attempts. Try again in a moment."
msgstr "Zbyt wiele prób. Spróbuj ponownie za chwilę."

#: src/errors.ts
msgid "Too many emails sent. Try again in a few minutes."
msgstr "Wysłano zbyt wiele wiadomości. Spróbuj ponownie za kilka minut."

#. Glossary term: user
#: src/glossary.ts
msgctxt "glossary"
msgid "user"
msgstr "użytkownik"

#: src/errors.ts
msgid "We could not find this convention."
msgstr "Nie znaleziono tego konwentu."

#: src/errors.ts
msgid "We could not find what you are looking for."
msgstr "Nie znaleziono tego, czego szukasz."

#: src/emails.ts
msgid "We received a request to change the email address of your OPOS account from {oldEmail} to {newEmail}. Confirm it with the link below."
msgstr "Otrzymaliśmy prośbę o zmianę adresu e-mail twojego konta w OPOS z {oldEmail} na {newEmail}. Potwierdź ją, korzystając z poniższego linku."

#: src/emails.ts
msgid "We received a request to reset the password of your OPOS account. Set a new password with the link below."
msgstr "Otrzymaliśmy prośbę o zresetowanie hasła do twojego konta w OPOS. Ustaw nowe hasło, korzystając z poniższego linku."

#: src/errors.ts
msgid "Wrong email or password."
msgstr "Nieprawidłowy e-mail lub hasło."

#: src/errors.ts
msgid "You are already in this convention's team."
msgstr "Już należysz do zespołu tego konwentu."

#: src/emails.ts
msgid "You are now a member of the organizing team of {tenantName} in OPOS. Open the panel to see what you can work on."
msgstr "Należysz teraz do zespołu organizatorów konwentu {tenantName} w OPOS. Otwórz panel, aby zobaczyć, nad czym możesz pracować."

#: src/errors.ts
msgid "You cannot change your own role or permissions, or remove yourself from the team."
msgstr "Nie możesz zmienić własnej roli ani uprawnień, ani usunąć siebie z zespołu."

#: src/errors.ts
msgid "You cannot delete the active edition. Activate another edition first."
msgstr "Nie możesz usunąć aktywnej edycji. Najpierw aktywuj inną edycję."

#: src/errors.ts
msgid "You cannot give anyone access that lasts longer than yours."
msgstr "Nie możesz nikomu nadać dostępu, który trwałby dłużej niż twój."

#: src/errors.ts
msgid "You cannot grant permissions higher than your own."
msgstr "Nie możesz nadać uprawnień wyższych niż własne."

#: src/errors.ts
msgid "You cannot raise the permissions of someone whose access lasts longer than yours."
msgstr "Nie możesz zwiększyć uprawnień osoby, której dostęp trwa dłużej niż twój."

#: src/errors.ts
msgid "You do not have permission to do this."
msgstr "Nie masz uprawnień, żeby to zrobić."

#: src/emails.ts
msgid "You have been invited to the organizing team of {tenantName} in OPOS. Accept the invitation with the link below. If you do not have an OPOS account yet, you can create one on the same page."
msgstr "Zaproszono cię do zespołu organizatorów konwentu {tenantName} w OPOS. Przyjmij zaproszenie, korzystając z poniższego linku. Jeśli nie masz jeszcze konta w OPOS, możesz je założyć na tej samej stronie."

#: src/emails.ts
msgid "You have joined the organizing team of {tenantName}"
msgstr "Dołączono cię do zespołu organizatorów konwentu {tenantName}"

#: src/errors.ts
msgid "Your session has ended. Sign in again."
msgstr "Twoja sesja wygasła. Zaloguj się ponownie."
