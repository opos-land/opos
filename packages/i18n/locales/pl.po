msgid "language"
msgstr "język"

#. Glossary term: like (noun)
#: src/glossary.ts
msgctxt "glossary"
msgid "like"
msgstr "polubienie"

#. Glossary term: module
#: src/glossary.ts
msgctxt "glossary"
msgid "module"
msgstr "moduł"

#: src/errors.ts
msgid "No account uses this email address."
msgstr "Żadne konto nie używa tego adresu e-mail."

#: src/errors.ts
msgid "Only a head organizer can edit or remove another head organizer."
msgstr "Tylko główny organizator może edytować lub usunąć innego głównego organizatora."

#. Glossary term: order
#: src/glossary.ts
msgctxt "glossary"
msgid "order"
msgstr "zamówienie"

#. Glossary term: org
#: src/glossary.ts
