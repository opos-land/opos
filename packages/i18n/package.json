{
  "name": "@opos/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./glossary": "./src/glossary.ts",
    "./errors": "./src/errors.ts",
    "./lingui.config.base": "./lingui.config.base.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n:check": "lingui check sync && lingui check missing --mode catalog --locale pl"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0"
  },
  "devDependencies": {
    "@lingui/cli": "^6.10.0",
    "@lingui/conf": "^6.10.0",
    "@lingui/format-po": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@opos/eslint-config": "workspace:*",
    "@opos/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
