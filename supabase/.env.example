# Read by the Supabase CLI for the env() values of supabase/config.toml.
# `pnpm infra:init` writes supabase/.env from this file and fills the secrets.

# Signs the send-email hook; the same value as SEND_EMAIL_HOOK_SECRET in apps/api/.env
# (v1,whsec_ and a base64 key). Filled by pnpm infra:init.
SEND_EMAIL_HOOK_SECRET=
# Where Supabase Auth, inside its container, reaches the API's send-email hook
SEND_EMAIL_HOOK_URI=http://host.docker.internal:3001/hooks/send-email

# The portal's address: the default redirect of Supabase Auth's links
SITE_URL=http://opos.localhost:5174
# Redirect targets Supabase Auth allows: the confirm pages of the portal and the panel
PORTAL_CONFIRM_URL=http://opos.localhost:5174/auth/confirm
PANEL_CONFIRM_URL=http://panel.opos.localhost:5173/auth/confirm
# Where Google sends the visitor back to the API
GOOGLE_CALLBACK_URL=http://api.opos.localhost:3001/auth/google/callback

# A personal Google OAuth client; leave empty unless working on Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
