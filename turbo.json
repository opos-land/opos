{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".github/workflows/**",
    "supabase/config.toml",
    "supabase/.env.example",
    "scripts/infra-init.mjs",
    "mise.toml"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "i18n:compile"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["VITE_API_URL", "SUPABASE_SECRET_KEY"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["i18n:compile"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["OPOS_PANEL_PORT", "OPOS_PORTAL_PORT"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit", "i18n:compile", "^i18n:compile"],
      "passThroughEnv": [
        "DATABASE_MIGRATION_URL",
        "OPOS_ENV",
        "OPOS_APP_PASSWORD",
        "OPOS_APP_GLOBAL_PASSWORD",
        "SUPABASE_LOCAL_SMTP_PORT"
      ]
    },
    "@opos/api#test": {
      "dependsOn": ["transit", "i18n:compile", "^i18n:compile", "@opos/db#test"],
      "passThroughEnv": [
        "DATABASE_MIGRATION_URL",
        "OPOS_ENV",
        "OPOS_APP_PASSWORD",
        "OPOS_APP_GLOBAL_PASSWORD",
        "SUPABASE_LOCAL_SMTP_PORT"
      ]
    },
    "test:e2e": {
      "dependsOn": ["@opos/panel#i18n:compile", "@opos/portal#i18n:compile"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "SUPABASE_LOCAL_SMTP_PORT",
        "OPOS_PANEL_PORT",
        "OPOS_PORTAL_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "i18n:extract": {
      "cache": false
    },
    "i18n:compile": {
      "dependsOn": ["^i18n:compile"],
      "outputs": ["src/locales/*.mjs", "locales/*.mjs"]
    },
    "i18n:check": {},
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_MIGRATION_URL", "OPOS_ENV"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_MIGRATION_URL", "OPOS_ENV"]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": ["DATABASE_MIGRATION_URL", "OPOS_ENV"]
    },
    "db:roles": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_MIGRATION_URL",
        "OPOS_ENV",
        "OPOS_APP_PASSWORD",
        "OPOS_APP_GLOBAL_PASSWORD"
      ]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_MIGRATION_URL",
        "OPOS_ENV",
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY"
      ]
    },
    "db:verify": {
      "cache": false,
      "passThroughEnv": ["DATABASE_MIGRATION_URL", "OPOS_ENV"]
    },
    "db:tenant:create": {
      "cache": false,
      "passThroughEnv": ["DATABASE_MIGRATION_URL", "OPOS_ENV"]
    },
    "db:account:reset-2fa": {
      "cache": false,
      "dependsOn": ["i18n:compile"],
      "passThroughEnv": [
        "DATABASE_MIGRATION_URL",
        "OPOS_ENV",
        "SUPABASE_URL",
        "SUPABASE_SECRET_KEY",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "MAIL_FROM"
      ]
    },
    "db:tenant:rename": {
      "cache": false,
      "passThroughEnv": ["DATABASE_MIGRATION_URL", "OPOS_ENV"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_MIGRATION_URL", "OPOS_ENV"]
    }
  }
}
