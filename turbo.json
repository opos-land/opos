{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "i18n:compile"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["i18n:compile"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    "i18n:extract": {
      "cache": false
    },
    "i18n:compile": {
      "dependsOn": ["^i18n:compile"],
      "outputs": ["src/locales/*.mjs", "locales/*.mjs"]
    },
    "i18n:check": {},
    "db:generate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT"
      ]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT"
      ]
    },
    "db:push": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT"
      ]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT",
        "AUTH_URL",
        "JWT_SECRET",
        "SUPABASE_SERVICE_ROLE_KEY",
        "OPOS_AUTH_PORT",
        "NODE_ENV"
      ]
    },
    "db:verify": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT"
      ]
    },
    "db:tenant:create": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT"
      ]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_GLOBAL_URL",
        "DATABASE_MIGRATION_URL",
        "OPOS_DB_PORT"
      ]
    }
  }
}
